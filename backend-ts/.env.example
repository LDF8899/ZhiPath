# ── MySQL ──
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=root123
MYSQL_DATABASE=zhipath

# ── MongoDB ──
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DATABASE=zhipath

# ── Redis ──
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Neo4j ──
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123

# ── LLM ──
# 可选: ollama | openai | deepseek | mimo | zhipu
LLM_PROVIDER=ollama
# Ollama (本地)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# OpenAI 兼容 API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
# DeepSeek (OpenAI 兼容端点)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
LLM_GEN_MODEL=deepseek-v4-flash-vision-exp
# 视觉/OCR 必须显式配置，避免静默落到纯文本 flash 模型
VISION_MODEL=deepseek-v4-flash-vision-exp
# 智谱 (备用，当前未启用)
ZHIPU_LLM_API_KEY=
ZHIPU_LLM_MODEL=glm-4-plus
ZHIPU_LLM_FLASH_MODEL=glm-5.2
ZHIPU_VISION_MODEL=glm-5v-turbo

# ── GitHub ──
GITHUB_TOKEN=

# ── 多模态智能体 (T5) ──
# 智谱 AI — 短视频生成 (CogVideoX)，缺省时短视频模态优雅降级
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_VIDEO_MODEL=cogvideox
# 讯飞 — 数字人讲解 (RTCPlayer 虚拟人)，缺省时数字人模态优雅降级
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_API_SECRET=
XFYUN_AVATAR_ID=110017
XFYUN_SERVICE_ID=

# ── App ──
APP_HOST=0.0.0.0
APP_PORT=3000
SECRET_KEY=change-me-in-production
JWT_EXPIRES_IN=7d
DEBUG=false

# ── SearXNG ──
SEARXNG_URL=http://127.0.0.1:8080
NEWS_FETCH_INTERVAL=14400
NEWS_FETCH_ENABLED=true

# ── MinIO ──
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=zhipath

# ── 高德地图（公司位置解析与静态地图） ──
AMAP_WEB_SERVICE_KEY=

# Evidence RAG / Chroma
# Windows Docker Desktop may expose Chroma on a different host port when 8000 is occupied by another local service.
CHROMA_URL=http://localhost:8001
CHROMA_COLLECTION=zhipath_user_evidence
CHROMA_TIMEOUT_MS=3000
# hash = local lightweight fallback. For model embeddings, set provider/base URL/model explicitly.
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMENSIONS=384
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
